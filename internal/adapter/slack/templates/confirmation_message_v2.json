{
  "name": "confirmation_message_v2",
  "schema_version": 1,
  "surface": "message",
  "payload": {
    "fallback_text": "{{value.fallback_text}}",
    "blocks": [
      {
        "type": "card",
        "title": {"type": "mrkdwn", "text": "{{value.title_summary}}", "verbatim": false},
        "subtitle": {"type": "mrkdwn", "text": "{{value.subtitle}}", "verbatim": false}
      },
      {
        "type": "section",
        "text": {"type": "plain_text", "text": "{{value.proposed_task}}", "emoji": false},
        "fields": [
          {"type": "plain_text", "text": "{{value.project}}", "emoji": false}
        ]
      },
      {
        "type": "actions",
        "block_id": "confirmation_buttons",
        "elements": [
          {
            "type": "button",
            "action_id": "local_agent.confirm.approve",
            "value": "{{value.wrapper_call_id}}",
            "text": {"type": "plain_text", "text": "Approve", "emoji": false},
            "style": "primary"
          },
          {
            "type": "button",
            "action_id": "local_agent.confirm.reject",
            "value": "{{value.wrapper_call_id}}",
            "text": {"type": "plain_text", "text": "Reject", "emoji": false},
            "style": "danger"
          },
          {
            "type": "button",
            "action_id": "local_agent.job.status",
            "value": "{{value.wrapper_call_id}}",
            "text": {"type": "plain_text", "text": "Ver estado", "emoji": false}
          }
        ]
      }
    ]
  }
}
