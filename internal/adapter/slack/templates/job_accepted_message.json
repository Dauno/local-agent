{
  "name": "job_accepted_message",
  "schema_version": 1,
  "surface": "message",
  "payload": {
    "fallback_text": "{{value.fallback_text}}",
    "blocks": [
      {
        "type": "card",
        "title": {"type": "mrkdwn", "text": "*Job accepted / running*", "verbatim": false},
        "subtitle": {"type": "mrkdwn", "text": "{{value.subtitle}}", "verbatim": false},
        "body": {"type": "mrkdwn", "text": "{{value.status_sentence}}", "verbatim": false}
      },
      {
        "type": "context",
        "elements": [
          {"type": "mrkdwn", "text": "{{value.created_at}}"},
          {"type": "mrkdwn", "text": "{{value.updated_at}}"}
        ]
      }
    ]
  }
}
