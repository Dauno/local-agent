{
  "name": "onboarding_message",
  "schema_version": 1,
  "surface": "message",
  "payload": {
    "fallback_text": "Local Agent puede analizar proyectos, revisar errores, resumir contexto y ayudarte a crear agentes. Puedes abrir el formulario o describir una necesidad.",
    "blocks": [
      {
        "type": "section",
        "text": {"type": "mrkdwn", "text": "{{value.intro}}"}
      },
      {
        "type": "actions",
        "block_id": "onboarding_actions",
        "elements": [
          {
            "type": "button",
            "action_id": "local_agent.builder.open",
            "value": "{{value.builder_context}}",
            "text": {"type": "plain_text", "text": "Abrir formulario", "emoji": false},
            "style": "primary"
          },
          {
            "type": "button",
            "action_id": "local_agent.onboarding.describe",
            "value": "{{value.builder_context}}",
            "text": {"type": "plain_text", "text": "{{value.describe_prompt}}", "emoji": false}
          }
        ]
      },
      {
        "type": "section",
        "text": {"type": "mrkdwn", "text": "*Acciones comunes:*\n• Analiza un error o un proyecto.\n• Resume contexto y decisiones.\n• Prepara un plan verificable."}
      },
      "{{options.suggested_prompts}}"
    ]
  }
}
